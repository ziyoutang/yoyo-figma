rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedGoogle() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    match /allowedUsers/{email} {
      allow get: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email == email;
      allow list, write: if false;
    }
    // Functions write jobs and users; the browser only reads its own documents.
    match /jobs/{jobId} {
      allow get: if isVerifiedGoogle() && resource.data.owner == request.auth.uid;
      allow list, write: if false;
    }
    match /users/{uid} {
      allow get: if isVerifiedGoogle() && request.auth.uid == uid;
      allow list, write: if false;
    }
    // Published heroes are public through Storage; their records stay with the owner. Only functions write.
    match /heroes/{heroId} {
      allow get, list: if isVerifiedGoogle() && resource.data.owner == request.auth.uid;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
