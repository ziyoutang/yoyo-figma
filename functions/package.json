{
  "name": "depth-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "tsc && node --test \"lib/**/*.test.js\"",
    "test:emulator": "tsc && firebase emulators:exec --only firestore,storage --project demo-depth \"node --test lib/heroes.emulator.js lib/generation.emulator.js lib/agent.emulator.js\"",
    "eval:agent": "tsc && node scripts/agent-eval.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "typescript": "~5.8.3"
  }
}
